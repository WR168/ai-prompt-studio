# ============================================================
# 密钥模板：复制本文件为 secrets.toml 再填真实值
# （secrets.toml 已被 .gitignore 排除，永远不会上传到 GitHub）
#
# 配置来源：
#   智谱开放平台  https://open.bigmodel.cn  → API Keys
#   Supabase      Dashboard → Project Settings → API
#   密码/额度     自定义
# ============================================================

# 网页访问密码（防白嫖）。留空 "" = 不启用密码门禁
APP_PASSWORD = ""

# 每人每日 AI 扩写次数上限（防刷额度，只限制 AI 调用，本地模板不受限）
DAILY_LIMIT = 20

# 【必填】Cookie 签名密钥：HMAC-SHA256 签名设备昵称 Cookie，防止用户手改 Cookie 伪造他人身份。
# 不配置或少于 32 字符时应用会拒绝启动（fail-closed，不允许降级为不签名）。
# 必填：至少 32 字符。生成：python -c "import secrets; print(secrets.token_hex(32))"
COOKIE_SIGN_KEY = "change-me-to-a-random-64-hex-string"

# 会话最长有效时间（小时）。超过后自动登出，需重新输入密码。默认 8 小时
SESSION_MAX_HOURS = 8

[llm]
# 智谱 GLM（OpenAI 兼容格式）
API_BASE = "https://open.bigmodel.cn/api/paas/v4"
API_KEY = "在这里填入智谱 APIKey（形如 xxxxxxxx.yyyyyyyy）"
# 主模型：glm-4.5-air 严格执行长文本/结构化指令；能力递增 glm-4-flash < glm-4-air < glm-4.5-air < glm-4-plus
# 改这里即可无缝切换，代码无需改动
MODEL = "glm-4.5-air"
# 兜底模型：主模型调用失败（限流/网络抖动/临时下线）时自动切换重试一次
# glm-4.7-flash 免费速度快，适合兜底；也可用 glm-4-flash
MODEL_FALLBACK = "glm-4.7-flash"

[supabase]
# Project URL：填 https://你的项目ID.supabase.co 即可，
# 带 /rest/v1 后缀（如 https://xxx.supabase.co/rest/v1/）也兼容
SUPABASE_URL = "https://你的项目ID.supabase.co"
# Publishable key（sb_publishable_ 开头；旧版项目对应 anon public key）
SUPABASE_KEY = "sb_publishable_xxxxxxxxxxxxxxxx"
